{
  "training_config": {
    "model_inputs": {
      "active_image_features": [
        "observation.images.camera1",
        "observation.images.camera2"
      ]
    },
    "peft": {
      "enabled": true,
      "method_type": "LORA",
      "base_model_name_or_path": "lerobot/smolvla_base",
      "target_modules": "model\\.vlm_with_expert\\.vlm\\.model\\.(text_model\\.layers|vision_model\\.encoder\\.layers)\\..*\\.self_attn\\.(q|v)_proj",
      "full_training_modules": [
        "model.vlm_with_expert.lm_expert",
        "model.state_proj",
        "model.action_in_proj",
        "model.action_out_proj",
        "model.action_time_mlp_in",
        "model.action_time_mlp_out"
      ],
      "r": 8
    },
    "data_loading": {
      "tensorboard": {
        "log_input_images_every_n_steps": 50,
        "log_input_metadata_every_n_steps": 50
      }
    },
    "training": {
      "batch_size": 8,
      "num_workers": 4,
      "policy_repo_id": "mhlee1215/so101-smolvla-grip-the-cube-v2",
      "policy_push_to_hub": false,
      "steps_per_epoch": 1293,
      "validation_max_batches": 64,
      "checkpoint_retention_policy": "best_val_and_closed_loop"
    },
    "losses": {
      "action_prefix": {
        "steps": 15,
        "weight": 1.5
      },
      "action_chunk_consistency": {
        "steps": 15,
        "weight": 0.05
      },
      "action_overlap_consistency": {
        "offset": 15,
        "horizon": 15,
        "weight": 0.02
      },
      "action_requery_consistency": {
        "offset": 15,
        "horizon": 15,
        "weight": 0.01
      },
      "action_smoothness": {
        "weight": 0.015,
        "include_gripper": false
      },
      "action_wrist_roll_circular": {
        "weight": 0.1,
        "joint_index": 4,
        "period_radians": 6.283185307179586
      },
      "action_teacher_importance": {
        "delta_weight": 0.25,
        "gripper_transition_weight": 1.0,
        "terminal_steps": 20,
        "terminal_weight": 1.5
      }
    },
    "closed_loop": {
      "runner": "picklift",
      "eval_skill_mode": "grip_the_cube_v1",
      "env_id": "MuJoCoPickLift-v1",
      "task_prompt": "grip the green cube and lift",
      "action_contract_mode": "processor",
      "record_rollout_gif": true,
      "tensorboard_media": {
        "train_reference_frequency": "once_per_run"
      },
      "inference": {
        "mode": "temporal_ensemble",
        "temporal_ensemble_decay": 0.01,
        "rtc": {
          "prefix_attention_schedule": "EXP",
          "max_guidance_weight": 10.0,
          "execution_horizon": 10,
          "inference_delay": 0,
          "debug": false,
          "debug_maxlen": 100
        }
      },
      "action_rmse_sweep": {
        "enabled": true,
        "n_action_steps": [1, 3, 5, 10, 15, 30, 40, 50],
        "tensorboard_tag": "closed_loop/<test_id>/action_rmse_sweep",
        "y_axis_max": 0.2
      }
    },
    "augmentation": {
      "state_jitter_std": 0.01,
      "state_jitter_prob": 0.35,
      "state_jitter_arm_only": true,
      "state_dropout_prob": 0.02,
      "state_dropout_keep_gripper": true,
      "image_camera_dropout_prob": 0.0,
      "image_patch_dropout_prob": 0.0,
      "image_patch_mask_ratio": 0.0,
      "image_color_jitter": true,
      "image_sharpness_jitter": true,
      "image_affine_degrees": 0.0,
      "image_affine_translate": 0.0,
      "image_noise_std": 0.01,
      "image_motion_blur_prob": 0.1,
      "gpu_image_augmentation": true
    }
  }
}
