      "root": "_workspace/so101_lerobot/grip_the_cube_v2_5_validation",
      "grid_bin_sidecar": "_workspace/so101_lerobot/grip_the_cube_v2_5_validation/meta/camera_grid_bins/observation_images_camera1_4x4_frame0.parquet",
