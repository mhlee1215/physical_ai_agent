        },
        "validation": "grip_the_cube_v2_5_validation"
      }
    },
    "closed_loop": {
      "test_cases": [
        {
          "id": "grip_the_cube_v2_5_clean_valid_mask_200",
          "description": "Clean held-out starts with two-confirmation valid-mask early stop and a 200-step hard cap.",
          "episodes": 10,
          "steps": 200,
          "seed": 98100,
          "start_contract": "dataset_episode_start",
          "task_prompt": "grip the green cube and lift",
          "env_object_color": "green",
          "success_metric": "grasped",
          "start_report_path": "_workspace/so101_lerobot/grip_the_cube_v2_5_validation/meta/closed_loop/grip_the_cube_v2_5_validation_clean_start10.json",
